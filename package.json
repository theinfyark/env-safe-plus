{
  "name": "env-safe-plus",
  "version": "1.1.0",
  "description": "Tiny, typed environment variable validator with defaults, type coercion, and clear errors.",
  "type": "module",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js",
      "require": "./dist/index.cjs",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "test": "node --test tests/env.test.js",
    "prepublishOnly": "npm test && npm run build",
    "build": "tsup src/index.js --format cjs --clean --sourcemap"
  },
  "keywords": [
    "env",
    "environment",
    "validator",
    "process.env",
    "config",
    "dotenv",
    "schema",
    "type-safe",
    "env-validator",
    "environment-variables",
    "config-validation",
    "validation",
    "12-factor",
    "nodejs"
  ],
  "author": "anilachary",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theinfyark/env-safe-plus.git"
  },
  "bugs": {
    "url": "https://github.com/theinfyark/env-safe-plus/issues"
  },
  "homepage": "https://github.com/theinfyark/env-safe-plus#readme",
  "engines": {
    "node": ">=18"
  },
  "types": "./types/index.d.ts",
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/anilachary"
  },
  "module": "./src/index.js",
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "esbuild": ">=0.28.1",
    "nanoid": ">=3.3.18",
    "postcss": ">=8.5.23",
    "browserslist": ">=4.28.7",
    "brace-expansion": ">=2.1.4"
  }
}
